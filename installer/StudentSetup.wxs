<?xml version="1.0" encoding="utf-8"?>
<!-- ExamWatch-Student-Setup.exe: friendly setup wizard around ExamWatch-Student.msi.
     Reads examwatch-student.cfg from the folder the .exe was started from, and
     refuses up front, in plain words, when that file is missing. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle Name="ExamWatch Student" Manufacturer="ExamWatch" Version="$(Version)"
          UpgradeCode="1fb4be71-cd8e-44bf-b786-ac85df1e36a7" IconSourceFile="$(IconFile)"
          AboutUrl="https://github.com/Monokayser/examwatch">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication LicenseFile="License.rtf" Theme="rtfLicense" SuppressOptionsUI="yes" />
    </BootstrapperApplication>

    <util:FileSearch Id="CfgSearch" Path="[WixBundleOriginalSourceFolder]examwatch-student.cfg" Variable="CFGFOUND" Result="exists" />
    <bal:Condition Message="The settings file examwatch-student.cfg was not found next to this installer.&#13;&#10;&#13;&#10;In the ExamWatch teacher dashboard click 'Add student PCs', extract the downloaded ZIP, and run the installer from that folder (both files must be together)."
                   Condition="CFGFOUND OR WixBundleInstalled" />
    <bal:Condition Message="ExamWatch needs 64-bit Windows 10 (version 22H2) or Windows 11." Condition="VersionNT64 &gt;= v10.0" />

    <Chain>
      <MsiPackage SourceFile="$(StudentMsi)" Visible="no">
        <MsiProperty Name="CFGDIR" Value="[WixBundleOriginalSourceFolder]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
